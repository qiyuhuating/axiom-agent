{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Axiom Agent",
  "version": "0.5.0",
  "identifier": "io.github.qiyuhuating.axiom",
  "build": {
    "beforeBuildCommand": "npm run prepare:desktop",
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../.desktop-runtime/": "runtime/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
