{
  "name": "axiom-agent",
  "version": "0.5.1",
  "description": "Pi-powered local engineering workbench with DeepSeek Harness components",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\"",
    "start": "node src/server.mjs",
    "pi": "node scripts/pi.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "prestart": "npm run build:ui",
    "runtime:stop": "node scripts/runtime-stop.mjs",
    "prepare:desktop": "pwsh -NoProfile -File scripts/prepare-desktop.ps1",
    "desktop:build": "npm exec --yes --package=@tauri-apps/cli@2.12.5 -- tauri build --bundles nsis",
    "format": "biome format --write src ui",
    "lint": "biome check src ui"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "croner": "11.0.1",
    "diff": "8.0.4",
    "koffi": "3.1.1",
    "typebox": "1.3.27"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lexical/history": "0.49.0",
    "@lexical/plain-text": "0.49.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "clsx": "2.1.1",
    "esbuild": "0.28.2",
    "lexical": "0.49.0",
    "lucide-react": "1.75.0",
    "markdown-it": "15.0.3",
    "node-pty": "1.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
